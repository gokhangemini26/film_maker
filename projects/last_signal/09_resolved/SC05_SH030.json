  "animation": {
    "camera": {
      "easing": "none",
      "notes": "locked off"
    },
    "characters": {
      "hana": {
        "eyeline": "down on the phone to the cut; she never looks up",
        "face": "reading -> small_smile (lower lids lift, corners up, lips closed, slight head dip); no teeth, no grin, no gasp, no blush, no hand to the mouth, no graphic symbols; the smile does not grow during the hold",
        "keys": [
          {
            "f": 0,
            "pose": "reading: phone low in both hands, headphones around her neck, eyes down on the screen, face soft and attentive",
            "t": 0.0
          },
          {
            "f": 2,
            "pose": "eyes track the text in three small steps (f2, f6, f10), a short hold on the last line (f10-14)",
            "t": 0.08
          },
          {
            "f": 14,
            "pose": "lower lids begin to lift (ease-in, f14-20)",
            "t": 0.58
          },
          {
            "f": 16,
            "pose": "mouth corners rise, lips closed (ease-in-out, f16-22)",
            "t": 0.67
          },
          {
            "f": 18,
            "pose": "head dips slightly, about 4 deg (f18-24)",
            "t": 0.75
          },
          {
            "f": 20,
            "pose": "shoulders settle 1 cm (f20-26)",
            "t": 0.83
          },
          {
            "f": 22,
            "pose": "the small smile has landed: held f22-51 (30 frames) - a moving hold with one slow breath",
            "t": 0.92
          },
          {
            "f": 36,
            "pose": "one soft blink (f36-41); the lids return to their lifted smile shape",
            "t": 1.5
          }
        ],
        "locomotion": {
          "note": "seated",
          "type": "none"
        },
        "secondary": [
          "headphones ride the collar with the shoulder settle (parented, no simulation)"
        ]
      }
    },
    "props": {
      "phone_hana": "held low, still; its glow on her face steady"
    },
    "timing": {
      "fps": 24,
      "frames": 52,
      "index": "0-based; f0 is the first frame, t = f / 24"
    }
  },
