{
  "animation": {
    "camera": {
      "easing": "none",
      "notes": "locked off at the SH050 end position (no move after the send)"
    },
    "characters": {
      "ren": {
        "breath": "one long out-breath f8-22; no more crank-locked breathing",
        "crank_clamp": "as SC04_SH050 (top face about z 0.66, tipped toward the lens, pip above the near knee) for all 28 frames; it is still in his lap (knees up), per continuity SC04_end in_lap",
        "eyeline": "the phone f0-9, then closed",
        "face": "release_after_send (eyes close, breath out); no smile, no grin",
        "keys": [
          {
            "f": 0,
            "pose": "still cranking at 1 turn/s, the SH050 end pose exactly: crank clamped high between his knees (top face and pip above the near knee), phone in the left hand at about z 0.76 over the near knee beside the port end; handle about 120 deg past the top; eyes on the phone",
            "pose_ref": "kerb_sit.cranking.eyes_phone",
            "t": 0.0
          },
          {
            "f": 0,
            "pose": "right hand slows the handle (ease-out, f0-4)",
            "pose_ref": "kerb_sit.cranking.slowing",
            "t": 0.0
          },
          {
            "f": 4,
            "pose": "fingers open: he lets go of the knob",
            "pose_ref": "kerb_sit.crank_let_go",
            "t": 0.17
          },
          {
            "f": 7,
            "pose": "handle coasts about 30 deg and clicks to a stop just past the bottom (phase from SC04_SH050: top at SC04_SH080 f50, so f0 here is 120 deg past the top)",
            "pose_ref": "kerb_sit.crank_let_go",
            "t": 0.29
          },
          {
            "f": 8,
            "pose": "release: long breath out, shoulders drop 3 cm, spine loosens a little (ease-out, f8-22); right hand comes to rest open on the crank (f8-16). The knees stay where they are, so the crank stays clamped high and readable; the phone sinks only about 2 cm with the shoulders and stays beside the crank, not over it",
            "pose_ref": "kerb_sit.release.hand_open_on_crank",
            "t": 0.33
          },
          {
            "f": 10,
            "pose": "eyes close (f10-13)",
            "pose_ref": "kerb_sit.release.eyes_closing",
            "t": 0.42
          },
          {
            "f": 22,
            "pose": "held, eyes closed, to the cut; crank and phone side by side in the lower frame",
            "pose_ref": "kerb_sit.release.eyes_closed",
            "t": 0.92
          }
        ],
        "locomotion": {
          "note": "seated on the kerb",
          "type": "none"
        },
        "phone_hold": "left hand, about z 0.74-0.78, over the near knee just left of the port end, screen up to his face; crank and phone both readable in frame; the phone never covers the crank body or pip",
        "secondary": [
          "cable loop settles on his knee as the crank stops (keyed)"
        ]
      }
    },
    "preview_frame": 16,
    "preview_frame_reason": "the release as a still: hand open on the stopped crank, eyes closed, shoulders half down, crank and phone together in the lower frame (the pip fade is motion and cannot be stilled)",
    "props": {
      "crank_charger": "handle stops at f7 and stays; pip brightness falls with the handle speed f2-7 (to about 40 %) and fades to off f7-12 (within 6 frames of the stop, look.lighting.power_indicators); crank rests in his lap, clamped high between his knees, arm out, readable in frame beside the phone",
      "phone_ren": "bolt goes off at f7 (source no longer live; not readable here); 2 %, screen steady"
    },
    "sound_sync": "last ratchet click at f7 (the stop); breath out from f8",
    "timing": {
      "fps": 24,
      "frames": 28,
      "index": "0-based; f0 is the first frame, t = f / 24"
    }
  },
