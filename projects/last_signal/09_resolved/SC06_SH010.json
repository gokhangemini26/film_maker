          },
          {
            "f": 0,
            "pose": "watches the screen fade (f0-24) without reaching for it: completely still",
            "t": 0.0
          },
          {
            "f": 20,
            "pose": "lean back begins: spine loosens and reclines against the car's rear quarter, slow ease-in-out (f20-46); knees stay up but open about 10 deg",
            "t": 0.83
          },
          {
            "f": 24,
            "pose": "left hand carries the dark phone to his chest (f24-40)",
            "t": 1.0
          },
          {
            "f": 40,
            "pose": "phone laid flat on the oat centre strip, screen facing out; hand lies flat over it and settles (f40-46)",
            "t": 1.67
          },
          {
            "f": 40,
            "pose": "eyes lift first (f40-43), then the head tips up toward the sky, up and to screen left (ease-in-out, f42-56)",
            "t": 1.67
          },
          {
            "f": 50,
            "pose": "final look up arrives: eyelids low, mouth soft, the faintest ease at the corners (f50-60)",
            "t": 2.08
          },
          {
            "f": 56,
            "pose": "hold: one slow breath (in f56-68, out f68-81), shoulders rise and fall 0.5 cm; nothing else moves",
