  "animation": {
    "camera": {
      "easing": "none",
      "notes": "locked off; no shake on the clunk"
    },
    "characters": {
      "ren": {
        "eyeline": "dash f0-14, glovebox f15-30, lap and crank f33-47",
        "face": "freeze during the cough, neutral-busy, then brows lifted at the crank; no graphic symbols",
        "keys": [
          {
            "f": 0,
            "pose": "right hand already on the ignition key (quick burst in from the cut), phone in the left hand on his thigh, eyes to the dash",
            "t": 0.0
          },
          {
            "f": 3,
            "pose": "turns the key: wrist rotates about 60 deg over 2 frames",
            "t": 0.12
          },
          {
            "f": 5,
            "pose": "small freeze while the engine coughs: shoulders up 1 cm, eyes on the dash (f5-13)",
            "t": 0.21
          },
          {
            "f": 14,
            "pose": "engine catches: shoulders drop 1 cm, right hand leaves the key",
            "t": 0.58
          },
          {
            "f": 15,
            "pose": "leans across to the glovebox (frame left): torso tips, right arm reaches about 0.75 m, eyes on the glovebox (quick burst, ease-out)",
            "t": 0.62
          },
          {
            "f": 22,
            "pose": "fingers on the latch",
            "t": 0.92
          },
          {
            "f": 23,
            "pose": "latch released; lid drops by itself",
            "t": 0.96
          },
          {
            "f": 31,
            "pose": "the crank lands on his thighs (clunk): he freezes mid-lean",
            "t": 1.29
          },
          {
            "f": 33,
            "pose": "head turns down to his lap (f33-36)",
            "t": 1.38
          },
          {
            "f": 36,
            "pose": "held look at the crank (12 f): brows lifted slightly, mouth flat",
            "t": 1.5
          }
        ],
        "locomotion": {
          "note": "seated; leans across toward the glovebox",
          "type": "none"
        },
        "secondary": [
          "jacket hem swings with the lean (skinning only)",
          "tuft lags the lean by 1 frame"
        ]
      }
    },
    "props": {
      "car_body": "cough: two small shudders f5-8 and f9-12 (about 4 mm, 0.4 deg roll); catches at f14; idle tremble from f14, 1 mm alternating every 2 frames (sets up the stall in SH130)",
      "charging_cable": "still in the glovebox, posed",
      "crank_charger": "tips out f25, falls about 0.3 m on an arc (gravity ease-in), lands on his thighs f31, 1 cm bounce f32-33, settles f34; arm folded, pip off",
      "dash_lights_and_adapter_ring": "on in one frame at f14",
      "glovebox_lid": "drops by gravity f23-25 (ease-in), 2-frame bounce at the stop f26-27, rests open",
      "phone_ren": "stays in the left hand on his thigh; glow not visible"
    },
    "risks_m3": [
      "crank fall keyed on an arc, not a rigid-body simulation",
      "0.75 m reach from the driver's seat needs the torso lean; check proxy reach and seat-belt-free clearance at G6"
    ],
    "sound_sync": "key turn f3, coughs f5 and f9, catch f14, lid f25, clunk f31",
    "timing": {
      "fps": 24,
      "frames": 48,
      "index": "0-based; f0 is the first frame, t = f / 24"
    }
  },
