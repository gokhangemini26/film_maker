            "t": 0.0
          },
          {
            "f": 2,
            "pose": "eyes reach the edge of the door opening; head starts the turn, slow ease-in-out f2-16 (about 95 deg in 14 frames, 0.58 s; average about 165 deg/s, no snap)",
            "pose_ref": "kerb_hunch.head_turn_start",
            "t": 0.08
          },
          {
            "f": 4,
            "pose": "the look commits: eyes fixed on the door opening, head about 35 deg round (face near profile); the push-in starts here",
            "pose_ref": "kerb_hunch.head_turn_35",
            "t": 0.17
          },
          {
            "f": 10,
            "pose": "eyes land on the glovebox (head about 85 deg round, eyes carrying the last 30 deg); lost profile from here",
