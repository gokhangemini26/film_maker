            "t": 0.42
          },
          {
            "f": 16,
            "pose": "head arrives (about 115 deg), eyes recentre in the head; ease-out, no overshoot, no settle bounce",
            "pose_ref": "kerb_hunch.look_glovebox",
            "t": 0.67
          },
          {
            "f": 16,
            "pose": "held look (f16-19): brows level, mouth soft, still",
            "pose_ref": "kerb_hunch.look_glovebox",
            "t": 0.67
          },
          {
            "f": 20,
            "pose": "small breath in (f20-28): shoulders rise 1 cm; one slow blink f22-27",
