  "animation": {
    "camera": {
      "easing": "none",
      "notes": "locked off at the strongest low angle"
    },
    "characters": {
      "ren": {
        "eyeline": "the glovebox f0-36, the crank in his hands f37-59",
        "face": "focused calm (brows level, eyes on the glovebox, then on the crank); no comic expression",
        "keys": [
          {
            "f": 0,
            "pose": "hands off his knees (from SH030), weight shifting west, eyes on the glovebox; phone in the left hand",
            "t": 0.0
          },
          {
            "f": 6,
            "pose": "pivots onto the right knee, left foot steps forward (west) into a low lunge (ease-in-out, f6-16)",
            "t": 0.25
          },
          {
            "f": 16,
            "pose": "leans in through the doorway: left forearm braces on the passenger seat edge with the phone still in the hand; right arm extends to the glovebox (ease-out, f16-24)",
            "t": 0.67
          },
          {
            "f": 24,
            "pose": "right hand thumbs the latch and lowers the lid by hand (controlled ease-in-out, f24-30); no drop, no clunk",
            "t": 1.0
          },
          {
            "f": 30,
            "pose": "hand into the glovebox, closes on the crank",
            "t": 1.25
          },
          {
            "f": 33,
            "pose": "lifts it out: the wrist dips 1 cm under its weight, then rises (f33-36)",
            "t": 1.38
          },
          {
            "f": 36,
            "pose": "backs out of the doorway, crank drawn toward his chest (f36-44)",
            "t": 1.5
          },
          {
            "f": 42,
            "pose": "left hand leaves the seat and joins beneath the crank: phone flat in the left palm, screen up, against the crank's underside",
            "t": 1.75
          },
          {
            "f": 44,
            "pose": "reverses the lunge: left foot back, pivots and lowers onto the kerb at the same spot, back to the car (ease-in, f44-52)",
            "t": 1.83
          },
          {
            "f": 52,
            "pose": "seat lands softly; 2-frame settle of the weight (f52-54)",
            "t": 2.17
          },
          {
            "f": 54,
            "pose": "holds the crank in both hands in his lap, looks down at it; slow breath in (f54-59)",
            "t": 2.25
          }
        ],
        "locomotion": {
          "path": "street coords: from the kerb seat (x -0.1, y -1.0) onto the right knee, left foot steps west to about y -0.55 into a low lunge; torso leans in through the doorway (shoulders to about x 0.2, y -0.2); back to the same seat (x -0.1, y -1.0)",
          "speed_mps": "about 1.1 on the lunge step (0.45 m in 10 f)",
          "type": "kneel_lunge_and_return"
        },
        "secondary": [
          "jacket fronts swing forward on the lean-in and settle on the sit (skinning only)",
          "cable from the phone hangs in a short posed loop from the left hand"
        ]
      }
    },
    "props": {
      "crank_charger": "lifted from the glovebox f30-36, parented to the right hand, then to both hands from f42; arm folded, pip off",
      "glovebox_lid": "lowered by hand f24-30 (ease-in-out), left down",
      "phone_ren": "in the left hand throughout (continuity.props.phone_ren); 1 % flicker continues, dips at f9-10, f31-33 and f47-48"
    },
    "risks_m3": [
      "ASSUMPTION: the glovebox face sits about y +0.5 (just forward of the door opening); the reach from the lunge is about 0.7 m, at the limit of the proxy's arm; verify at G6",
      "the phone-under-crank two-hand hold needs a second attach point on hand_l; posed per frame if needed",
      "tempo: this is the busiest tender shot; the action is continuous and overlapped to fit 60 frames. If the G6 preview reads rushed, about 12 more frames would make it truly slow (duration is the cinematographer's)"
    ],
    "timing": {
      "fps": 24,
