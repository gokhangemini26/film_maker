{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "description": "The `fm:` block at the top of every managed document.\n\nEverything outside this block is the artifact's content and is hashed.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "e.g. story_bible, screenplay, color_bible",
          "title": "Kind",
          "type": "string"
        },
        "phase": {
          "title": "Phase",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "PROPOSED"
        },
        "owner_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Role"
        },
        "derived_from": {
          "items": {
            "$ref": "#/$defs/DepRef"
          },
          "title": "Derived From",
          "type": "array"
        },
        "serves": {
          "description": "intent.* ids",
          "items": {
            "type": "string"
          },
          "title": "Serves",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "stamped_content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stamped Content Hash"
        },
        "stamp_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stamp Note"
        }
      },
      "required": [
        "id",
        "kind",
        "phase"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "BreathKey": {
      "additionalProperties": false,
      "properties": {
        "f": {
          "description": "shot-local frame, 0-based",
          "minimum": 0,
          "title": "F",
          "type": "integer"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "free text for humans; never parsed",
          "title": "Note"
