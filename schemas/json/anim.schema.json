          "default": null,
          "description": "why this key serves the shot",
          "title": "Rationale"
        },
        "ref": {
          "enum": [
            "in_slow",
            "out_slow",
            "out_long",
            "hold",
            "crank_locked"
          ],
          "title": "Ref",
          "type": "string"
        },
        "dur_f": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dur F"
        }
      },
      "required": [
        "f",
        "ref"
      ],
      "title": "BreathKey",
      "type": "object"
    },
    "CameraTrack": {
      "additionalProperties": false,
